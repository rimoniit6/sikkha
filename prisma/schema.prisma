model BlogCategory {
  id           String     @id @default(cuid())
  name         String
  slug         String     @unique
  description  String?
  color        String?
  isActive     Boolean    @default(true)
  order        Int        @default(0)
  deletedAt    DateTime?
  deletedBy    String?
  deleteReason String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  posts        BlogPost[]

  @@index([isActive, deletedAt])
}

model BlogTag {
  id        String        @id @default(cuid())
  name      String
  slug      String        @unique
  createdAt DateTime      @default(now())
  posts     BlogPostTag[]
}

model BlogPost {
  id                      String            @id @default(cuid())
  title                   String
  slug                    String            @unique
  excerpt                 String?
  content                 String
  featuredImage           String?
  gallery                 String?
  authorId                String?
  categoryId              String?
  status                  String            @default("DRAFT")
  publishedAt             DateTime?
  scheduledAt             DateTime?
  viewCount               Int               @default(0)
  readingTime             Int?
  isFeatured              Boolean           @default(false)
  isPinned                Boolean           @default(false)
  allowComments           Boolean           @default(true)
  isActive                Boolean           @default(true)
  metaTitle               String?
  metaDescription         String?
  canonicalUrl            String?
  ogImage                 String?
  robots                  String?
  jsonLd                  String?
  contentBlocks           String?
  deletedAt               DateTime?
  deletedBy               String?
  deleteReason            String?
  seriesId                String?
  seriesOrder             Int?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  automationCorrelationId String?
  author                  User?             @relation(fields: [authorId], references: [id])
  category                BlogCategory?     @relation(fields: [categoryId], references: [id])
  series                  BlogSeries?       @relation(fields: [seriesId], references: [id])
  tags                    BlogPostTag[]
  relatedBy               BlogRelatedPost[] @relation("RelatedBy")
  relatedTo               BlogRelatedPost[] @relation("RelatedTo")

  @@index([status, publishedAt, isActive, deletedAt])
  @@index([categoryId, status, isActive, deletedAt])
  @@index([authorId])
  @@index([slug])
  @@index([isFeatured, status, isActive, deletedAt])
  @@index([publishedAt])
  @@index([seriesId])
}

model BlogPostTag {
  postId String
  tagId  String
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
}

model UserAchievement {
  id            String    @id @default(cuid())
  userId        String
  /// * Achievement identifier (e.g. "first-lecture", "streak-7")
  achievementId String
  /// * Current progress toward the achievement (0-100)
  progress      Float     @default(0)
  /// * Whether the achievement is unlocked
  unlocked      Boolean   @default(false)
  /// * When the achievement was unlocked
  unlockedAt    DateTime?
  /// * When the user claimed the reward
  claimedAt     DateTime?
  /// * Optional JSON metadata
  metadata      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId, unlocked])
  @@index([achievementId])
}

model BlogRelatedPost {
  id            String   @id @default(cuid())
  postId        String
  relatedPostId String
  post          BlogPost @relation("RelatedBy", fields: [postId], references: [id], onDelete: Cascade)
  relatedPost   BlogPost @relation("RelatedTo", fields: [relatedPostId], references: [id], onDelete: Cascade)

  @@unique([postId, relatedPostId])
  @@index([postId])
}

model BlogSeries {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  description String?
  coverImage  String?
  order       Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  posts       BlogPost[]
}

model SourceConfig {
  id            String        @id @default(cuid())
  name          String
  sourceType    String
  contentType   String
  url           String
  isActive      Boolean       @default(true)
  fetchInterval Int           @default(60)
  lastFetchedAt DateTime?
