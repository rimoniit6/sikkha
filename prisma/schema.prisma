  contentType     String
  /// * ID of the content (lectureId, chapterId, examId, etc.)
  contentId       String
  /// * Subject for display and routing
  subjectId       String
  /// * Optional chapter
  chapterId       String?
  /// * Optional topic-level identifier
  topicId         String?
  /// * Title for display
  title           String
  /// * Subtitle for display (e.g. chapter name)
  subtitle        String?
  /// * Current SM-2 interval in days
  intervalDays    Int       @default(1)
  /// * SM-2 ease factor (default 2.5, min 1.3)
  easeFactor      Float     @default(2.5)
  /// * Number of successful reviews
  reviewCount     Int       @default(0)
  /// * Confidence score (0-100) from weakness detection
  confidenceScore Int       @default(50)
  /// * When this item is next due for review
  nextReviewAt    DateTime
  /// * When this item was last reviewed
  lastReviewedAt  DateTime?
  /// * Whether review is completed for current cycle
  isCompleted     Boolean   @default(false)
  /// * Route to navigate to for review
  route           String
  /// * Route params
  routeParams     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentType, contentId])
  @@index([userId, nextReviewAt])
  @@index([userId, isCompleted])
  @@index([userId, contentType])
}

