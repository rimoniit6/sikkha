generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  name                    String?
  password                String?
  role                    String                   @default("STUDENT")
  avatar                  String?
  phone                   String?
  institute               String?
  classLevel              String?
  board                   String?
  learningMode            String?
  isVerified              Boolean                  @default(false)
  isPremium               Boolean                  @default(false)
  premiumExpiry           DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  assignmentSubmissions   AssignmentSubmission[]
  auditLogs               AuditLog[]
  blogPosts               BlogPost[]
  bookmarks               Bookmark[]
  cqExamPurchases         CQExamPackagePurchase[]
  cqExamReviewedRetakes   CQExamRetakeRequest[]    @relation("CQRetakeRequestReviewer")
  cqExamRetakeRequests    CQExamRetakeRequest[]    @relation("CQRetakeRequestUser")
  cqExamGradedSubmissions CQExamSubmission[]       @relation("CQSubmissionGrader")
  cqExamSubmissions       CQExamSubmission[]       @relation("CQSubmissionUser")
  certificates            Certificate[]
  courseEnrollments       CourseEnrollment[]
  coursePurchases         CoursePurchase[]
  createdExams            Exam[]
  examResults             ExamResult[]
  examSessions            ExamSession[]
  feedbackMessages        FeedbackMessage[]
  lessonProgress          LessonProgress[]
  mcqExamPurchases        MCQExamPackagePurchase[]
  mcqExamReviewedRetakes  MCQExamRetakeRequest[]   @relation("MCQRetakeRequestReviewer")
  mcqExamRetakeRequests   MCQExamRetakeRequest[]   @relation("MCQRetakeRequestUser")
  mcqExamResults          MCQExamSetResult[]
  notes                   Note[]
  notifications           Notification[]
  payments                Payment[]
  progress                Progress[]
  recentlyViewed          RecentlyViewed[]
  revisionQueue           RevisionQueue[]
  achievements            UserAchievement[]
  feedbacks               UserFeedback[]
  subscriptions           UserSubscription[]

  @@index([role])
  @@index([classLevel, board])
}

model ClassCategory {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  order           Int              @default(0)
  icon            String?
  color           String?
  gradient        String?
  description     String?
  isActive        Boolean          @default(true)
  deletedAt       DateTime?
  deletedBy       String?
  deleteReason    String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  cqExamPackages  CQExamPackage[]
  Course          Course[]
  mcqExamPackages MCQExamPackage[]
  subjects        Subject[]
}

model Subject {
  id           String        @id @default(cuid())
  name         String
  slug         String
  classId      String
  icon         String?
  color        String?
  description  String?
  order        Int           @default(0)
  isActive     Boolean       @default(true)
  deletedAt    DateTime?
  deletedBy    String?
  deleteReason String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  chapters     Chapter[]
  Course       Course[]
  class        ClassCategory @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([slug, classId])
  @@index([classId, isActive, deletedAt, order])
}

model Chapter {
  id                 String              @id @default(cuid())
  name               String
  slug               String
  subjectId          String
  order              Int                 @default(0)
  description        String?
  isActive           Boolean             @default(true)
  deletedAt          DateTime?
  deletedBy          String?
  deleteReason       String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  cqs                CQ[]
  subject            Subject             @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  knowledgeQuestions KnowledgeQuestion[]
  lectures           Lecture[]
  mcqs               MCQ[]
  suggestions        Suggestion[]        @relation("ChapterSuggestions")
  topics             Topic[]

  @@unique([slug, subjectId])
  @@index([subjectId, isActive, deletedAt, order])
}

model Topic {
  id           String    @id @default(cuid())
  name         String
  slug         String
  chapterId    String
  order        Int       @default(0)
  description  String?
  isActive     Boolean   @default(true)
  deletedAt    DateTime?
  deletedBy    String?
  deleteReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  chapter      Chapter   @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([slug, chapterId])
  @@index([chapterId])
}

model KnowledgeQuestion {
  id            String    @id @default(cuid())
  chapterId     String
  type          String
  question      String
  answer        String
  questionImage String?
  answerImage   String?
  isPremium     Boolean   @default(false)
  price         Float     @default(0)
  order         Int       @default(0)
  isActive      Boolean   @default(true)
  deletedAt     DateTime?
  deletedBy     String?
  deleteReason  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  chapter       Chapter   @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([chapterId, type, isActive, deletedAt])
  @@index([isPremium, isActive, deletedAt])
}

model Lecture {
  id           String     @id @default(cuid())
  title        String
  slug         String
  chapterId    String
  content      String
  videoUrl     String?
  audioUrl     String?
  pdfUrl       String?
  thumbnail    String?
  duration     Int        @default(0)
  order        Int        @default(0)
  isPremium    Boolean    @default(false)
  price        Float      @default(0)
  viewCount    Int        @default(0)
  isActive     Boolean    @default(true)
  deletedAt    DateTime?
  deletedBy    String?
  deleteReason String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  chapter      Chapter    @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  resources    Resource[]

  @@index([chapterId, isActive, deletedAt])
  @@index([isPremium, isActive, deletedAt])
}

model Resource {
  id           String    @id @default(cuid())
  lectureId    String
  title        String
  type         String
  url          String
  size         String?
  isActive     Boolean   @default(true)
  deletedAt    DateTime?
  deletedBy    String?
  deleteReason String?
  createdAt    DateTime  @default(now())
  lecture      Lecture   @relation(fields: [lectureId], references: [id], onDelete: Cascade)

  @@index([lectureId])
}

model MCQ {
  id               String               @id @default(cuid())
  question         String
  questionImage    String?
  optionA          String
  optionAImage     String?
  optionB          String
  optionBImage     String?
  optionC          String
  optionCImage     String?
  optionD          String
  optionDImage     String?
  correctAnswer    String
  explanation      String?
  explanationImage String?
  chapterId        String
  classLevel       String
  subjectId        String
  board            String?
  year             String?
  topic            String?
  difficulty       String               @default("MEDIUM")
  isPremium        Boolean              @default(false)
  price            Float                @default(0)
  tags             String?
  isActive         Boolean              @default(true)
  deletedAt        DateTime?
  deletedBy        String?
  deleteReason     String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  yearId           String?
  chapter          Chapter              @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  examYear         ExamYear?            @relation(fields: [yearId], references: [id])
  examSetQuestions MCQExamSetQuestion[]

  @@index([classLevel, subjectId, chapterId, isActive, deletedAt])
  @@index([chapterId, isActive, deletedAt])
  @@index([board, year, isActive, deletedAt])
  @@index([board, year, classLevel, isActive, deletedAt])
  @@index([yearId])
}

model CQ {
  id               String              @id @default(cuid())
  uddeepok         String
  uddeepokImage    String?
  question1        String
  question1Image   String?
  question2        String
  question2Image   String?
  question3        String
  question3Image   String?
  question4        String
  question4Image   String?
  answer1          String
  answer1Image     String?
  answer2          String
  answer2Image     String?
  answer3          String
  answer3Image     String?
  answer4          String
  answer4Image     String?
  chapterId        String
  classLevel       String
  subjectId        String
  board            String?
  year             String?
  topic            String?
  difficulty       String              @default("MEDIUM")
  isPremium        Boolean             @default(false)
  price            Float               @default(0)
  tags             String?
  isActive         Boolean             @default(true)
  deletedAt        DateTime?
  deletedBy        String?
  deleteReason     String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  yearId           String?
  chapter          Chapter             @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  examYear         ExamYear?           @relation(fields: [yearId], references: [id])
  examSetQuestions CQExamSetQuestion[]

  @@index([classLevel, subjectId, chapterId, isActive, deletedAt])
  @@index([chapterId, isActive, deletedAt])
  @@index([board, year, isActive, deletedAt])
  @@index([board, year, classLevel, isActive, deletedAt])
  @@index([yearId])
}

model Exam {
  id                String         @id @default(cuid())
  title             String
  description       String?
  classLevel        String
  subjectId         String?
  chapterIds        String?
  type              String
  duration          Int
  totalMarks        Int            @default(0)
  marksPerMcq       Float          @default(1)
  negativeMarks     Float          @default(0)
  passingPercentage Float?
  isPremium         Boolean        @default(false)
  price             Float          @default(0)
  isActive          Boolean        @default(true)
  status            String         @default("DRAFT")
  instructions      String?
  startsAt          DateTime?
  endsAt            DateTime?
  creatorId         String?
  deletedAt         DateTime?
  deletedBy         String?
  deleteReason      String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  creator           User?          @relation(fields: [creatorId], references: [id])
  questions         ExamQuestion[]
  results           ExamResult[]
  sessions          ExamSession[]

  @@index([classLevel, isActive, deletedAt])
  @@index([subjectId])
  @@index([status, isActive, deletedAt])
  @@index([subjectId, classLevel, isActive, deletedAt])
  @@index([isActive, deletedAt, createdAt])
  @@index([creatorId])
}

model ExamQuestion {
  id           String   @id @default(cuid())
  examId       String
  questionType String
  questionId   String
  order        Int      @default(0)
  marks        Float    @default(0)
  createdAt    DateTime @default(now())
  exam         Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([examId, questionType, questionId])
  @@index([examId])
  @@index([questionId])
}

model ExamResult {
  id             String    @id @default(cuid())
  userId         String
  examId         String
  attemptNumber  Int       @default(1)
  score          Float     @default(0)
  totalMarks     Float     @default(0)
  percentage     Float     @default(0)
  isPassed       Boolean?
  correct        Int       @default(0)
  wrong          Int       @default(0)
  skipped        Int       @default(0)
  timeTaken      Int       @default(0)
  answers        String
  idempotencyKey String?   @unique
  createdAt      DateTime  @default(now())
  completedAt    DateTime  @default(now())
  deletedAt      DateTime?
  exam           Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, examId, attemptNumber])
  @@index([userId])
  @@index([examId])
  @@index([userId, examId])
  @@index([userId, completedAt])
}

model ExamSession {
  id                   String   @id @default(cuid())
  userId               String
  examId               String
  startedAt            DateTime @default(now())
  expiresAt            DateTime
  status               String   @default("IN_PROGRESS")
  currentQuestionIndex Int      @default(0)
  answers              String   @default("{}")
  lastActivityAt       DateTime @default(now())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  exam                 Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, examId, status])
  @@index([userId])
  @@index([examId])
  @@index([status])
}

model Progress {
  id           String   @id @default(cuid())
  userId       String
  contentId    String
  contentType  String
  progress     Float    @default(0)
  lastAccessed DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId, contentType])
  @@index([userId, contentType, lastAccessed])
  @@index([userId, lastAccessed])
}

model Bookmark {
  id          String   @id @default(cuid())
  userId      String
  contentId   String
  contentType String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId, contentType])
  @@index([userId, createdAt])
}

model Note {
  id          String   @id @default(cuid())
  userId      String
  contentId   String
  contentType String
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId, contentType])
  @@index([userId])
}

model UserFeedback {
  id        String            @id @default(cuid())
  userId    String
  subject   String
  status    String            @default("PENDING")
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  messages  FeedbackMessage[]
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model FeedbackMessage {
  id         String       @id @default(cuid())
  feedbackId String
  senderId   String
  senderRole String
  message    String
  createdAt  DateTime     @default(now())
  feedback   UserFeedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  sender     User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([feedbackId])
  @@index([senderId])
}

model RecentlyViewed {
  id          String   @id @default(cuid())
  userId      String
  contentId   String
  contentType String
  title       String
  viewedAt    DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, viewedAt])
  @@index([userId, contentType, viewedAt])
}

model Payment {
  id                      String                   @id @default(cuid())
  userId                  String
  amount                  Float
  method                  String
  transactionId           String                   @unique
  paymentNumber           String
  screenshot              String?
  contentType             String?
  contentId               String?
  contentTitle            String?
  classLevel              String?
  status                  String                   @default("PENDING")
  isActive                Boolean                  @default(true)
  adminNote               String?
  reviewedBy              String?
  reviewedAt              DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  idempotencyKey          String?                  @unique
  deletedAt               DateTime?
  cqexamPackagePurchases  CQExamPackagePurchase[]
  coursePurchases         CoursePurchase[]
  mcqexamPackagePurchases MCQExamPackagePurchase[]
  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentType, contentId, status])
  @@index([userId, contentType, contentId])
  @@index([status, createdAt])
  @@index([contentType, contentId, status])
  @@index([reviewedBy])
  @@index([userId, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  title     String
  message   String
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  category  String?
  priority  String   @default("medium")
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([userId, category, createdAt])
  @@index([isRead, createdAt])
}

model AuditLog {
  id            String    @id @default(cuid())
  adminId       String?
  action        String
  entityType    String
  entityId      String
  oldData       String?
  newData       String?
  ipAddress     String?
  userAgent     String?
  userName      String?
  userRole      String?
  status        String    @default("success")
  duration      Int?
  os            String?
  browser       String?
  country       String?
  sessionId     String?
  requestId     String?
  correlationId String?
  createdAt     DateTime  @default(now())
  hash          String?
  deletedAt     DateTime?
  admin         User?     @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@index([status])
  @@index([os, browser])
  @@index([sessionId])
  @@index([requestId])
  @@index([correlationId])
  @@index([action, createdAt])
  @@index([adminId, createdAt])
  @@index([entityType, action])
}

model ContentVersion {
  id                  String   @id @default(cuid())
  entityType          String
  entityId            String
  versionNumber       Int
  snapshot            String
  changedFields       String?
  changeType          String
  rollbackFromVersion Int?
  rollbackComment     String?
  performedBy         String
  performedByName     String?
  performedByRole     String?
  ipAddress           String?
  userAgent           String?
  createdAt           DateTime @default(now())

  @@unique([entityType, entityId, versionNumber])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([performedBy])
  @@index([changeType])
}

model Banner {
  id           String    @id @default(cuid())
  title        String
  subtitle     String?
  image        String?
  link         String?
  buttonText   String?
  isActive     Boolean   @default(true)
  order        Int       @default(0)
  startDate    DateTime?
  endDate      DateTime?
  deletedAt    DateTime?
  deletedBy    String?
  deleteReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([isActive, deletedAt])
}

model FAQ {
  id           String    @id @default(cuid())
  question     String
  answer       String
  category     String?
  order        Int       @default(0)
  isActive     Boolean   @default(true)
  deletedAt    DateTime?
  deletedBy    String?
  deleteReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([isActive, deletedAt, category])
}

model Testimonial {
  id           String    @id @default(cuid())
  name         String
  role         String?
  avatar       String?
  content      String
  rating       Int       @default(5)
  isActive     Boolean   @default(true)
  order        Int       @default(0)
  deletedAt    DateTime?
  deletedBy    String?
  deleteReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([isActive, order])
}

model Notice {
  id           String    @id @default(cuid())
  title        String
  content      String?
  pdfUrl       String?
  linkUrl      String?
  linkLabel    String?
  type         String    @default("TEXT")
  thumbnail    String?
  classLevel   String?
  isPinned     Boolean   @default(false)
  isActive     Boolean   @default(true)
  order        Int       @default(0)
  deletedAt    DateTime?
  deletedBy    String?
  deleteReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([isActive, deletedAt, type, order, createdAt])
  @@index([classLevel, isActive, deletedAt])
}

model Suggestion {
  id           String    @id @default(cuid())
  title        String
  slug         String    @unique
  content      String
  classId      String?
  subjectId    String?
  chapterId    String?
  thumbnail    String?
  pdfUrl       String?
  isPremium    Boolean   @default(false)
  price        Float     @default(0)
  viewCount    Int       @default(0)
  order        Int       @default(0)
  isActive     Boolean   @default(true)
  deletedAt    DateTime?
  deletedBy    String?
  deleteReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  chapter      Chapter?  @relation("ChapterSuggestions", fields: [chapterId], references: [id])

  @@index([chapterId])
  @@index([isActive, deletedAt, chapterId])
  @@index([isActive, deletedAt, classId, subjectId])
}

model Board {
  id           String    @id @default(cuid())
  name         String
  slug         String    @unique
  color        String    @default("rose")
  isActive     Boolean   @default(true)
  order        Int       @default(0)
  deletedAt    DateTime?
  deletedBy    String?
  deleteReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model ExamYear {
  id             String          @id @default(cuid())
  year           String          @unique
  isActive       Boolean         @default(true)
  order          Int             @default(0)
  deletedAt      DateTime?
  deletedBy      String?
  deleteReason   String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  boardYears     BoardYear[]
  cqs            CQ[]
  contentBundles ContentBundle[]
  mcqs           MCQ[]
}

model BoardYear {
  id           String    @id @default(cuid())
  board        String
  year         String
  isActive     Boolean   @default(true)
  deletedAt    DateTime?
  deletedBy    String?
  deleteReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  yearId       String?
  examYear     ExamYear? @relation(fields: [yearId], references: [id])

  @@unique([board, year])
  @@index([yearId])
}

model ContentType {
  id                  String    @id @default(cuid())
  key                 String    @unique
  labelBn             String
  labelEn             String
  description         String?
  icon                String
  color               String
  lightColor          String?
  textColor           String?
  route               String?
  paramKey            String?
  buttonLabel         String?
  showInChapterDetail Boolean   @default(true)
  isActive            Boolean   @default(true)
  order               Int       @default(0)
  deletedAt           DateTime?
  deletedBy           String?
  deleteReason        String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model FeaturedContent {
  id           String    @id @default(cuid())
  contentType  String
  contentId    String
  title        String?
  subtitle     String?
  thumbnail    String?
  section      String    @default("homepage")
  isActive     Boolean   @default(true)
  order        Int       @default(0)
  deletedAt    DateTime?
  deletedBy    String?
  deleteReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([section, contentType, contentId])
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  group     String?
  label     String?
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isRead, createdAt])
}

model Navigation {
  id           String    @id @default(cuid())
  label        String
  route        String
  icon         String    @default("BookOpen")
  location     String    @default("header")
  order        Int       @default(0)
  isAuthOnly   Boolean   @default(false)
  isAdminOnly  Boolean   @default(false)
  isActive     Boolean   @default(true)
  deletedAt    DateTime?
  deletedBy    String?
  deleteReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([location, isActive])
}

model ContentBundle {
  id            String       @id @default(cuid())
  title         String
  slug          String       @unique
  description   String?
  thumbnail     String?
  price         Float        @default(0)
  originalPrice Float        @default(0)
  classLevel    String?
  board         String?
  year          String?
  type          String       @default("MIXED")
  isActive      Boolean      @default(true)
  order         Int          @default(0)
  deletedAt     DateTime?
  deletedBy     String?
  deleteReason  String?
  createdAt     DateTime     @default(now())
