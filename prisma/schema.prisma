  processedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, nextRetryAt])
  @@index([status, lockedUntil])
  @@index([aggregateType, aggregateId])
  @@index([eventType])
}

model InboxMessage {
